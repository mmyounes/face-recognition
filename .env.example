# ---------------------------------------------------------------
# Couchbase connection
# ---------------------------------------------------------------
# Connection string for your cluster.
#   Capella:      couchbases://cb.<your-endpoint>.cloud.couchbase.com
#   Self-managed: couchbase://localhost
COUCHBASE_HOST=couchbases://cb.your-endpoint.cloud.couchbase.com
COUCHBASE_USER=your_database_username
COUCHBASE_PASSWORD=your_database_password

# ---------------------------------------------------------------
# Use case 1: Face registration & verification
# ---------------------------------------------------------------
# Bucket / scope / collection that stores registered faces
COUCHBASE_BUCKET=face_recognition
FACE_RECOGNITION_SCOPE=faces
FACE_RECOGNITION_COLLECTION=users

# Max cosine distance accepted as a match (0 = identical). Lower = stricter.
VERIFY_DISTANCE_THRESHOLD=0.2

# ---------------------------------------------------------------
# Use case 2: Celebrity look-alike
# ---------------------------------------------------------------
# Bucket that holds the celebrity embeddings (uses its _default collection)
CELEB_BUCKET=celeb

# ---------------------------------------------------------------
# Flask
# ---------------------------------------------------------------
PORT=5000
FLASK_DEBUG=false
